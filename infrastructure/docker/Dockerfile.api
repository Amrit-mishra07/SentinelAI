FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/srv/sentinel/apps/aipcsr-api:/srv/sentinel/core/db-core \
    REPORTS_DIR=/reports

WORKDIR /srv/sentinel
COPY apps/aipcsr-api/requirements.txt apps/aipcsr-api/requirements.txt
RUN pip install --no-cache-dir -r apps/aipcsr-api/requirements.txt \
    && groupadd --gid 10001 sentinel \
    && useradd --uid 10001 --gid sentinel --create-home --shell /usr/sbin/nologin sentinel \
    && mkdir /reports \
    && chown 10001:10001 /reports
COPY --chown=10001:10001 apps/aipcsr-api/ apps/aipcsr-api/
COPY --chown=10001:10001 core/ core/

USER 10001:10001
WORKDIR /srv/sentinel/apps/aipcsr-api
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["sh", "-c", "cd /srv/sentinel/core/db-core && alembic upgrade head && cd /srv/sentinel/apps/aipcsr-api && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]
