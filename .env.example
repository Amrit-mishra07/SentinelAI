# Development database. Change DATABASE_URL too when changing these credentials.
POSTGRES_USER=aipcsr
POSTGRES_PASSWORD=aipcsr_dev
POSTGRES_DB=aipcsr
DATABASE_URL=postgresql://aipcsr:aipcsr_dev@db:5432/aipcsr
REDIS_URL=redis://redis:6379/0
HTTP_PORT=8080

# Required: generate unique values using the commands in README.md.
JWT_SECRET=
SECRETS_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:8080"]

# Optional server key. A saved user key takes precedence.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
MAX_AI_FINDINGS_PER_SCAN=25

REPORTS_DIR=/reports
SCANNER_SANDBOX=bwrap
SCANNER_TIMEOUT_SECONDS=300
CLONE_TIMEOUT_SECONDS=120

# Optional GitHub OAuth; callback points to /api/integrations/github/oauth/callback
PUBLIC_BASE_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=
# Optional SMTP provider; notification preferences are opt-in
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Dedicated private scanner RPC authentication; generate a unique random value
SCANNER_SERVICE_TOKEN=
